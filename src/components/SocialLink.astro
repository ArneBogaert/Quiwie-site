---
const { href, icon, imgSrc, title, color, isExternal = true } = Astro.props;
---

<a href={href} class="link-item" target={isExternal ? '_blank' : '_self'}>
  <span class="link-icon-wrapper" style={`background: ${color || 'var(--accent-color)'}20;`}>
    {
      imgSrc ? (
        <img src={imgSrc} alt={`${title} logo`} />
      ) : (
        <i class={icon} style={`color: ${color};`} />
      )
    }
  </span>
  <span class="link-title">{title}</span>
</a>

<style>
  .link-icon-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .link-title {
    flex: 1;
    text-align: center;
    padding-right: 36px;
  }
</style>
