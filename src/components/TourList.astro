---
const tours = await Astro.glob('../content/tours/*.md');
const sortedTours = tours.sort(
  (a, b) =>
    new Date(a.frontmatter.datum).getTime() -
    new Date(b.frontmatter.datum).getTime(),
);
---

<div class="tour-list">
  {
    sortedTours.map((tour) => (
      <div class="tour-item scroll-reveal">
        <div class="tour-info">
          <span class="tour-date">
            {new Date(tour.frontmatter.datum).toLocaleDateString('nl-BE')}
          </span>
          <span class="tour-location">{tour.frontmatter.locatie}</span>
        </div>
        <a href={tour.frontmatter.tickets} target="_blank" class="tour-btn">
          Info&Tickets
        </a>
      </div>
    ))
  }
</div>

<style>
  .tour-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 25px;
  }
  .tour-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(139, 111, 71, 0.15);
    border-radius: 12px;
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(44, 36, 22, 0.06);
    transition: all 0.25s ease;
  }
  .tour-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(44, 36, 22, 0.1);
    border-color: var(--accent-color);
  }
  .tour-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }
  .tour-date {
    font-size: 0.8rem;
    color: var(--warm-brown);
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  .tour-location {
    font-weight: 700;
    color: var(--text-color);
    font-size: 0.95rem;
  }
  .tour-btn {
    background: var(--accent-color);
    color: #faf9f6;
    text-decoration: none;
    padding: 8px 18px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.3px;
    transition: background-color 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
  }
  .tour-btn:hover {
    background: var(--accent-light);
    transform: scale(1.05);
  }
</style>
