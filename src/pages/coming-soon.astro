---
import Layout from '../layouts/layout.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="Quiwie - Spotify Rijpt Nog">
  <style>
    .error-container {
      padding-top: 5vh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .temp-logo-wrapper {
      margin-bottom: 30px;
      display: flex;
      justify-content: center;
      width: 100%;
    }
    .temp-logo-text {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--accent-color);
      letter-spacing: 3px;
      text-transform: uppercase;
      text-align: center;
      line-height: 1.3;
      background: rgba(255, 255, 255, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 4px 20px rgba(44, 36, 22, 0.08);
      border-radius: 50%;
      width: 160px;
      height: 160px;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: float 5s ease-in-out infinite;
    }
    .error-message {
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 40px;
      padding: 0 10px;
      color: var(--text-color);
    }
    .back-button {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background-color: var(--accent-color);
      color: #faf9f6;
      text-decoration: none;
      padding: 16px 32px;
      border-radius: 50px;
      font-weight: bold;
      transition:
        transform 0.2s,
        background-color 0.2s,
        box-shadow 0.2s;
      box-shadow: 0 4px 14px rgba(107, 122, 46, 0.15);
      border: none;
    }
    .back-button:hover {
      transform: scale(1.04);
      background-color: #5c6b28;
      box-shadow: 0 8px 24px rgba(107, 122, 46, 0.25);
    }
    .presave-btn {
      background-color: #1db954;
      margin-bottom: 15px;
      box-shadow: 0 4px 14px rgba(29, 185, 84, 0.15);
    }
    .presave-btn:hover {
      background-color: #17a34a;
      box-shadow: 0 8px 24px rgba(29, 185, 84, 0.25);
    }
  </style>

  <div class="container error-container">
    <div class="temp-logo-wrapper">
      <span class="temp-logo-text">Coming<br/>Soon</span>
    </div>

    <h1 class="band-name">Nog even geduld!</h1>

    <div class="error-message">
      <p>Onze excuses voor de radiostilte op Spotify.</p>
      <p>
        We leggen de laatste hand aan de mix zodat jullie binnenkort optimaal
        van ons gejengel kunnen genieten.
      </p>
    </div>

    <a
      href="https://distrokid.com/hyperfollow/quiwie/jouw-link"
      class="back-button presave-btn"
      target="_blank"
    >
      <i class="fab fa-spotify"></i> Pre-save op Spotify
    </a>

    <a href={baseUrl} class="back-button">
      <i class="fas fa-arrow-left"></i> Ik wil terug
    </a>
  </div>
</Layout>
